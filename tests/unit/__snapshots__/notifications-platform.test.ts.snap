exports[`Windows toast XML > matches the snapshot 1`] = `"<toast launch="maybepile://item/11111111-1111-4111-8111-111111111111" activationType="protocol"><visual><binding template="ToastGeneric"><text>Pick up where you left off</text><text>Frieren — next: S1E12</text></binding></visual><actions><action content="Snooze 1 h" activationType="protocol" arguments="maybepile://action/snooze?target=item%3A11111111-1111-4111-8111-111111111111&amp;for=1h"/><action content="Mute" activationType="protocol" arguments="maybepile://action/mute?target=item%3A11111111-1111-4111-8111-111111111111"/></actions><audio src="ms-winsoundevent:Notification.Reminder"/></toast>"`;

exports[`registration templates > Windows task XML (snapshot) round-trips through the parser 1`] = `
"<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Author>Maybe Pile</Author>
    <Description>Maybe Pile reminder check (created at your request in Settings → Notifications; remove it there).</Description>
    <URI>\\MaybePile\\ReminderCheck</URI>
  </RegistrationInfo>
  <Triggers>
    <TimeTrigger>
      <Repetition>
        <Interval>PT15M</Interval>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
      <StartBoundary>2026-01-01T00:00:00</StartBoundary>
      <Enabled>true</Enabled>
    </TimeTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>true</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT1M</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\\Users\\Ann\\AppData\\Local\\Programs\\Maybe Pile\\Maybe Pile.exe</Command>
      <Arguments>--reminder-check</Arguments>
    </Exec>
  </Actions>
</Task>
"
`;

exports[`registration templates > systemd units, autostart and URL handler (snapshots) 1`] = `
"# Created by Maybe Pile (Settings → Notifications → Wake on schedule). Remove it there.
[Unit]
Description=Maybe Pile reminder check
After=graphical-session.target

[Service]
Type=oneshot
Environment=ELECTRON_RUN_AS_NODE=1
ExecStart="/opt/Maybe Pile/maybe-pile" "/home/ann/.config/MaybePile/helper/reminder-check.cjs" --reminder-check --data-dir "/home/ann/.config/MaybePile"
TimeoutStartSec=30
Nice=10
NoNewPrivileges=true
"
`;

exports[`registration templates > systemd units, autostart and URL handler (snapshots) 2`] = `
"# Created by Maybe Pile (Settings → Notifications → Wake on schedule). Remove it there.
[Unit]
Description=Maybe Pile reminder check (every 15 min)

[Timer]
OnCalendar=*-*-* *:0/15:00
Persistent=true
AccuracySec=1min
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
"
`;

exports[`registration templates > systemd units, autostart and URL handler (snapshots) 3`] = `
"[Desktop Entry]
Type=Application
Name=Maybe Pile (background reminders)
Comment=Keeps Maybe Pile in the tray so reminders can arrive. Created at your request; remove it in Settings → Notifications.
Exec="/opt/Maybe Pile/maybe-pile" --hidden
Icon=maybe-pile
Terminal=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
"
`;
