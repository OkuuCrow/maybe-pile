{
  "name": "maybe-pile",
  "productName": "Maybe Pile",
  "version": "1.0.0",
  "description": "Someday, maybe. Now organized. A local-first desktop media backlog.",
  "private": true,
  "license": "MIT",
  "author": "Maybe Pile contributors",
  "main": "dist/main/main.cjs",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "axe-core": "4.14.1",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fflate": "0.8.3",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "4.1.12",
    "zod": "4.6.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "start": "npm run build && node scripts/run-electron.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.ui-tests.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:ui": "vitest run --project ui",
    "test:a11y": "vitest run --project ui -t a11y",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm run lint && npm run typecheck && npm test && npm run test:e2e",
    "icons": "node scripts/make-icons.mjs",
    "bench": "node scripts/run-ts.mjs scripts/bench.ts",
    "smoke:providers": "node scripts/run-ts.mjs scripts/provider-smoke.ts",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb rpm tar.gz",
    "licenses": "node scripts/licenses.mjs"
  }
}
